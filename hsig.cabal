cabal-version: 3.4
name:          hsig
version:       0.1.0.0
synopsis:      Оффлайн-синтезатор и DSL для электронной музыки
description:
  Библиотека и DSL на чистом Haskell для оффлайнового синтеза электронной
  музыки: трек описывается как обычный хаскелльный код и рендерится в WAV.
  Концепт и дорожная карта: docs/DESIGN.md.

license:       MIT
license-file:  LICENSE
copyright:     (c) 2026 Anton Gushcha
author:        Anton Gushcha
maintainer:    ncrashed@gmail.com
category:      Sound
build-type:    Simple
tested-with:   GHC ==9.10.3

flag llvm
  description:
    Сборка через LLVM-бэкенд (-fllvm). Требует opt/llc в PATH:
    nix develop .#llvm

  default:     False
  manual:      True

common opts
  default-language: GHC2021
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists -Wpartial-fields
    -Wredundant-constraints -O2 -funbox-strict-fields

    -- Хаддоки попадают в интерфейсы: :doc в cabal repl работает по ним.
    -haddock

  if flag(llvm)
    ghc-options: -fllvm

library
  import:          opts
  hs-source-dirs:  src
  other-modules:   Sound.Sig.Block
  exposed-modules:
    Sound.Sig
    Sound.Sig.Core
    Sound.Sig.Delay
    Sound.Sig.Dynamics
    Sound.Sig.Envelope
    Sound.Sig.Filter
    Sound.Sig.IO
    Sound.Sig.Nonlin
    Sound.Sig.Osc
    Sound.Sig.Random
    Sound.Sig.Render
    Sound.Sig.Resample
    Sound.Sig.Score
    Sound.Sig.Stereo

  build-depends:
    , base        >=4.19 && <5
    , bytestring  >=0.11 && <0.13
    , containers  >=0.6  && <0.9
    , directory   >=1.3  && <1.4
    , filepath    >=1.4  && <1.6
    , vector      >=0.13 && <0.14

executable demo
  import:         opts

  -- Трек пишут строками: ритм это литерал паттерна (разд. 10).
  default-extensions: OverloadedStrings
  hs-source-dirs:     tracks patches
  other-modules:
    Lead
    Reactor

  main-is:        Demo.hs

  -- Файл трека это модуль Demo, а не Main, Cabal сам -main-is не подставляет.
  ghc-options:    -main-is Demo -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , hsig

executable minimal
  import:         opts

  -- Ритм это литерал паттерна (разд. 10 дизайна).
  default-extensions: OverloadedStrings
  hs-source-dirs:     tracks
  main-is:            Minimal.hs
  ghc-options:        -main-is Minimal -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , hsig

executable book
  import:         opts

  -- Примеры книги пишутся тем же языком, что трек (разд. 10 дизайна).
  default-extensions: OverloadedStrings
  hs-source-dirs:     book patches
  main-is:            Main.hs
  other-modules:
    Book.Ch01
    Book.Ch02
    Book.Ch03
    Book.Ch04
    Book.Ch05
    Book.Ch06
    Book.Ch07
    Book.Ch08
    Book.Ch10
    Book.Ch11
    Book.Ch12
    Book.Ch13
    Book.Ch14
    Book.Ch15
    Book.Prelude
    Lead

  -- -M2g: промах в примере (забытое окно) обязан падать по куче, а не
  -- выедать машину. Примеры короткие, столько им не нужно никогда.
  ghc-options:    -threaded -rtsopts "-with-rtsopts=-N -M2g"
  build-depends:
    , base
    , directory
    , filepath
    , hsig

test-suite hsig-test
  import:         opts
  type:           exitcode-stdio-1.0
  hs-source-dirs: test patches
  main-is:        Main.hs

  -- -M4g: бесконечный сигнал в тесте обязан падать по куче, а не вешать
  -- машину. Ни один честный тест столько не просит.
  ghc-options:    -threaded -rtsopts "-with-rtsopts=-N -M4g"
  other-modules:
    BookSpec
    CoreSpec
    DelaySpec
    DynamicsSpec
    EnvelopeSpec
    FilterSpec
    Lead
    LeadSpec
    MiniSpec
    NonlinSpec
    OscSpec
    RandomSpec
    Reactor
    ReactorSpec
    RenderSpec
    ResampleSpec
    ScoreSpec
    TestIO
    StereoSpec
    Spectral
    WavSpec

  build-depends:
    , base
    , bytestring
    , directory
    , filepath
    , hsig
    -- 1.5.4: dependentTestGroup, до неё sequentialTestGroup
    , tasty             >=1.5.4 && <1.6
    , tasty-hunit       >=0.10 && <0.11
    , tasty-quickcheck  >=0.10 && <0.12
    , temporary         >=1.3  && <1.4
    , time              >=1.12 && <1.15
    , vector
    , vector-fftw       >=0.1  && <0.2
