cabal-version: 3.4
name:          hsig
version:       0.1.0.0
synopsis:      Оффлайн-синтезатор и DSL для электронной музыки
description:
  Библиотека и DSL на чистом Haskell для оффлайнового синтеза электронной
  музыки: трек описывается как обычный хаскелльный код и рендерится в WAV.
  Концепт и дорожная карта: docs/DESIGN.md.

license:       MIT
license-file:  LICENSE
copyright:     (c) 2026 Anton Gushcha
author:        Anton Gushcha
maintainer:    ncrashed@gmail.com
category:      Sound
build-type:    Simple
tested-with:   GHC ==9.10.3

flag llvm
  description:
    Сборка через LLVM-бэкенд (-fllvm). Требует opt/llc в PATH:
    nix develop .#llvm

  default:     False
  manual:      True

common opts
  default-language: GHC2021
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists -Wpartial-fields
    -Wredundant-constraints -O2 -funbox-strict-fields

  if flag(llvm)
    ghc-options: -fllvm

library
  import:          opts
  hs-source-dirs:  src
  other-modules:   Sound.Sig.Block
  exposed-modules:
    Sound.Sig
    Sound.Sig.Core
    Sound.Sig.Delay
    Sound.Sig.Dynamics
    Sound.Sig.Envelope
    Sound.Sig.Filter
    Sound.Sig.IO
    Sound.Sig.Nonlin
    Sound.Sig.Osc
    Sound.Sig.Random
    Sound.Sig.Render
    Sound.Sig.Resample
    Sound.Sig.Score
    Sound.Sig.Stereo

  build-depends:
    , base        >=4.19 && <5
    , bytestring  >=0.11 && <0.13
    , containers  >=0.6  && <0.9
    , directory   >=1.3  && <1.4
    , filepath    >=1.4  && <1.6
    , vector      >=0.13 && <0.14

executable demo
  import:         opts
  hs-source-dirs: tracks patches
  other-modules:  Lead
  main-is:        Demo.hs

  -- Файл трека это модуль Demo, а не Main, Cabal сам -main-is не подставляет.
  ghc-options:    -main-is Demo -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , hsig

test-suite hsig-test
  import:         opts
  type:           exitcode-stdio-1.0
  hs-source-dirs: test patches
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  other-modules:
    CoreSpec
    DelaySpec
    DynamicsSpec
    EnvelopeSpec
    FilterSpec
    Lead
    LeadSpec
    MiniSpec
    NonlinSpec
    OscSpec
    RandomSpec
    RenderSpec
    ResampleSpec
    ScoreSpec
    StereoSpec
    Spectral
    WavSpec

  build-depends:
    , base
    , bytestring
    , directory
    , filepath
    , hsig
    -- 1.5.4: dependentTestGroup, до неё sequentialTestGroup
    , tasty             >=1.5.4 && <1.6
    , tasty-hunit       >=0.10 && <0.11
    , tasty-quickcheck  >=0.10 && <0.12
    , temporary         >=1.3  && <1.4
    , vector
    , vector-fftw       >=0.1  && <0.2
